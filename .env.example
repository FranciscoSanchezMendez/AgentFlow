# AgentFlow · Variables de entorno
# Copia este archivo a .env.local y rellena solo lo que necesites.
# NUNCA subas .env.local ni claves reales al repositorio.
# Ninguna de estas variables lleva NEXT_PUBLIC_: solo se leen en el servidor.

# --- Modo de los agentes ---------------------------------------------------
# demo (por defecto): determinista, sin API keys ni coste.
# llm: usa modelos reales de Anthropic. Requiere ANTHROPIC_API_KEY;
#      si falta la clave, la app vuelve automáticamente al modo demo.
AGENTFLOW_MODE=demo
ANTHROPIC_API_KEY=
# Modelo opcional (por defecto: claude-opus-5-5)
AGENTFLOW_MODEL=

# Pausa entre pasos en modo demo, en ms (0-5000). Solo estética.
AGENTFLOW_DEMO_DELAY_MS=400

# --- Persistencia (opcional) ----------------------------------------------
# Sin estas variables el historial se guarda en memoria del servidor.
# Usa la service role key: solo vive en el servidor, nunca en el navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
